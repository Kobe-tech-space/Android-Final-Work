<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:padding="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📝 添加考试" android:textSize="26sp" android:textStyle="bold" android:textColor="@color/text_main" android:layout_marginBottom="16dp" />
        <EditText android:id="@+id/etExamName" android:layout_width="match_parent" android:layout_height="56dp" android:hint="考试名称" android:background="@drawable/bg_input_round" android:textColor="@color/text_main" android:textColorHint="@color/text_hint" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginBottom="10dp" />
        <EditText android:id="@+id/etLocation" android:layout_width="match_parent" android:layout_height="56dp" android:hint="考试地点" android:background="@drawable/bg_input_round" android:textColor="@color/text_main" android:textColorHint="@color/text_hint" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginBottom="10dp" />
        <EditText android:id="@+id/etExamTime" android:layout_width="match_parent" android:layout_height="56dp" android:hint="考试时间，如 2026-06-20 09:00" android:background="@drawable/bg_input_round" android:textColor="@color/text_main" android:textColorHint="@color/text_hint" android:paddingLeft="16dp" android:paddingRight="16dp" android:layout_marginBottom="10dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="56dp" android:text="保存并提醒" android:layout_marginTop="16dp" app:cornerRadius="16dp" />
    </LinearLayout>
</ScrollView>
