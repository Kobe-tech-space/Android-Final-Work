<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end|top" android:padding="8dp">
    <ImageButton android:id="@+id/btnDeleteMessage" android:layout_width="36dp" android:layout_height="36dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@android:drawable/ic_menu_delete" android:contentDescription="删除消息" android:visibility="gone" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end" android:layout_marginEnd="8dp">
        <TextView android:id="@+id/tvMessage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_user_bubble" android:padding="13dp" android:text="用户消息" android:textColor="@android:color/white" android:maxWidth="280dp" />
        <TextView android:id="@+id/tvTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="刚刚" android:textColor="@color/text_hint" android:textSize="11sp" android:layout_marginTop="3dp" />
    </LinearLayout>
    <TextView android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_avatar_user" android:gravity="center" android:text="我" android:textColor="@android:color/white" android:textSize="12sp" android:textStyle="bold" />
</LinearLayout>
